# OPENROUTER_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT=60s
# PORT=8080
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=60s
# SERVER_IDLE_TIMEOUT=120s
# RATE_LIMIT_RATE=10
# RATE_LIMIT_BURST=3
# RATE_LIMIT_TTL=10m
