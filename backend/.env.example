# Required API KEY
OPENROUTER_API_KEY=your-api-key-here

# LLM provider configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# LLM call timeout (must be less than SERVER_WRITE_TIMEOUT)
LLM_TIMEOUT=60s

# Prompt injection filter model (fast/cheap model, separate from analyzer)
# FILTER_MODEL=meta-llama/llama-3.1-8b-instruct
# FILTER_TIMEOUT=10s

# Server configuration
PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# Rate limiting (per-IP)
RATE_LIMIT_RATE=10
RATE_LIMIT_BURST=3
RATE_LIMIT_TTL=10m

# Optional: CORS origin (default: *)
# CORS_ORIGIN=*

# Optional: Trusted proxy CIDRs for rate limiting (comma-separated)
# TRUSTED_PROXIES=172.18.0.0/16
